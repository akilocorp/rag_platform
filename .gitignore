# ===================================================================
# General & System Files
# ===================================================================
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===================================================================
# Environment Variables & Secrets
# IMPORTANT: This prevents your API keys from being committed.
# ===================================================================
.env
*.local

# Copies and spillage of the above. A plain `.env` rule misses every way one
# actually shows up in a working tree: a second download ("_env (1).crash"), a
# hand-made backup, or a per-environment variant. These are the same secrets
# under a name the rule above does not match.
.env.*
!.env.example
*.env
_env*
*.crash
env.backup
.env.bak

# ===================================================================
# Backend (Python/Flask)
# ===================================================================
.venv
__pycache__/
*.pyc
instance/

# ===================================================================
# Frontend (React/Node.js)
# ===================================================================
node_modules
dist
dist-ssr
.vite/

# Runtime upload dump (Telegram bot) — not source
.telegram_uploads/

# ===================================================================
# Editor & IDE specific files
# ===================================================================
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Facilitator sandbox output: one transcript per tuning run, regenerated freely.
backend/tests/sim/runs/
